{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=AutoFlow;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "AutoFlow-Backend",
    "Audience": "AutoFlow-Users"
  },
  "SeedAdmin": {
    "Enabled": true,
    "Email": "admin@autoflow.local",
    "Password": "Admin@12345",
    "FirstName": "System",
    "LastName": "Admin"
  },
  "BusinessRules": {
    "LoyaltyDiscountThreshold": 5000.00,
    "LoyaltyDiscountRate": 0.10,
    "RegularCustomerMinimumPurchases": 3
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "your-email@gmail.com",
    "SenderName": "AutoFlow System",
    "Password": "your-app-password"
  },
  "AllowedHosts": "*"
}
